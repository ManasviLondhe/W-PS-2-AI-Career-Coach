# SkillProof AI Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# If left empty or if Atlas network whitelist fails, SkillProof AI automatically falls back to an embedded in-memory MongoDB instance
MONGODB_URI=mongodb://localhost:27017/skillproof

# GitHub Integration
# Optional personal access token (public repos work unauthenticated with 60 req/hr rate limit)
GITHUB_TOKEN=

# AI Career Coach & Job Requirement Extraction (Feature 1)
# Supported providers: gemini | openai | deterministic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=

# Background Polling Worker
POLL_INTERVAL_MS=15000
MAX_CONCURRENT_POLLS=3

# Security & CORS
CLIENT_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
